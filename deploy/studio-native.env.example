# Configuracao do Studio Native na VPS, lida pelo systemd (EnvironmentFile).
# O instalador copia este arquivo para /etc/studio-native/studio-native.env na
# primeira vez e nunca mais o sobrescreve. Depois de mudar algo la:
#   sudo systemctl restart studio-native

# Endereco publico do app. E para onde o TikTok devolve o navegador depois do
# login, e tem que bater byte a byte com o registrado no portal do TikTok e no
# ALLOWED_REDIRECTS do Worker (services/tiktok-auth).
STUDIO_PUBLIC_URL=https://native.toffa.com.br

# O app escuta so no loopback. Quem fala com a internet e o cloudflared, na
# mesma maquina -- e o app so confia nos cabecalhos da Cloudflare (IP real do
# visitante, HTTPS) quando o pedido vem do loopback.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=5050

# HTTPS de ponta a ponta: o cookie de sessao so viaja cifrado. Consequencia: o
# login nao funciona por http://127.0.0.1 (tunel SSH). Entre pelo endereco
# publico.
STUDIO_COOKIE_SECURE=1

# Dados (configuracao, biblioteca, videos, banco) e temporarios de upload. O
# temporario mora no disco porque em algumas distros /tmp e memoria (tmpfs).
STUDIO_DATA_DIR=/var/lib/studio-native
STUDIO_TMP_DIR=/var/lib/studio-native/tmp

# Quantos renders e normalizacoes rodam ao mesmo tempo. 1 para 2 vCPU; com
# 4 vCPU ou mais e RAM sobrando, 2. Sem esta linha: metade dos nucleos.
STUDIO_RENDER_SLOTS=1
